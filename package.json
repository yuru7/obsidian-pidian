{
  "name": "obsidian-pidian",
  "version": "0.18.0",
  "description": "Use a Pi coding agent from the Obsidian sidebar.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "analyze": "node esbuild.config.mjs production analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "bump-and-tag": "node scripts/bump-and-tag.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "pidian",
    "pi",
    "agent"
  ],
  "author": "yuru7",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.19.3",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "typebox": "1.3.20"
  },
  "devDependencies": {
    "@codemirror/view": "6.43.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/turndown": "^5.0.6",
    "esbuild": "0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
